# Monitoring reuses the existing backend Supabase project. Never use VITE_ for secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to the existing Render trace endpoint. Use localhost for local onboarding.
MONITORING_PUBLIC_OTLP_TRACES_URL=https://to-backendapi-v1-kctb.onrender.com/otlp/v1/traces
# Preserve existing entries when adding https://to-monitoring.vercel.app to FRONTEND_ORIGINS.

# Alpaca stock market data (server-side only; never prefix these with VITE_)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional; defaults to iex. Supported: sip, iex, delayed_sip, boats, overnight, otc
ALPACA_DATA_FEED=iex

# Server-side OpenWeb Ninja JSearch key; do not prefix with VITE_.
OPENWEBNINJA_API_KEY=
# Optional: cache duration in milliseconds (default 45 minutes; allowed 1 minute–24 hours).
JOBS_CACHE_TTL_MS=2700000

# Enable scheduled Studio alerts and the SOC replay on a continuously running test backend.
SPLUNK_ALERT_SCHEDULER_ENABLED=false
