# Alpaca stock market data (server-side only; never prefix these with VITE_)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Optional; defaults to iex. Supported: sip, iex, delayed_sip, boats, overnight, otc
ALPACA_DATA_FEED=iex

# Server-side OpenWeb Ninja JSearch key; do not prefix with VITE_.
OPENWEBNINJA_API_KEY=
# Optional: cache duration in milliseconds (default 45 minutes; allowed 1 minute–24 hours).
JOBS_CACHE_TTL_MS=2700000
