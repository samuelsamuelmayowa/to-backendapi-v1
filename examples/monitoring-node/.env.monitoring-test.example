# REVIEW ONLY. Synthetic local probe configuration; never source the app's .env.
# The probe runner creates equivalent settings with fresh ephemeral ports.
# This does not configure MAFACONNECT or provision a Supabase test environment.
OTEL_SERVICE_NAME=local-monitoring-test
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:14318/otlp/v1/traces
# Static synthetic test key, not valid in production.
OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-to-project-key=to_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express,mysql2
OTEL_NODE_RESOURCE_DETECTORS=env
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=100
OTEL_BSP_MAX_QUEUE_SIZE=1000
OTEL_BSP_SCHEDULE_DELAY=100
# No real DB credentials or remote URLs. Use the synthetic protocol endpoint.
